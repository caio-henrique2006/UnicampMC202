{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell", // Deve ser "shell" para aceitar o wildcard *.c
      "label": "Compile",
      "command": "gcc",
      "args": [
        "-g",                          // Gera simbolos de depuracao
        "${fileDirname}/*.c",      // Compila TODOS os arquivos .c do diretorio
        "-o",
        "${fileDirname}/darray"    // Garante que o binario seja salvo na raiz do projeto
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}